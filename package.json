{
  "name": "shared-public-web-components",
  "version": "0.0.0",
  "private": true,
  "description": "Workspace for @lumvir/web-components (library) and its playground.",
  "engines": {
    "node": ">=24.22.0"
  },
  "scripts": {
    "ng": "ng",
    "start": "ng serve playground",
    "build": "npm run build:lib && ng build playground && node scripts/check-package.mjs",
    "build:lib": "ng build web-components && cp README.md CHANGELOG.md dist/web-components/",
    "test": "ng test web-components",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc -p projects/web-components/tsconfig.lib.json --noEmit && tsc -p projects/web-components/tsconfig.spec.json --noEmit && tsc -p projects/playground/tsconfig.app.json --noEmit",
    "check:colors": "node scripts/check-no-colors.mjs",
    "pack:lib": "npm pack ./dist/web-components --pack-destination dist"
  },
  "dependencies": {
    "@angular/common": "22.2.3",
    "@angular/compiler": "22.2.3",
    "@angular/core": "22.2.3",
    "@angular/forms": "22.2.3",
    "@angular/platform-browser": "22.2.3",
    "@angular/router": "22.2.3",
    "rxjs": "7.8.2",
    "tslib": "2.8.1"
  },
  "devDependencies": {
    "@angular/build": "22.2.3",
    "@angular/cli": "22.2.3",
    "@angular/compiler-cli": "22.2.3",
    "@eslint/js": "10.0.1",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "26.6.5",
    "angular-eslint": "22.6.0",
    "eslint": "10.13.0",
    "jsdom": "30.1.3",
    "ng-packagr": "22.2.4",
    "postcss": "8.5.31",
    "prettier": "3.9.10",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.0",
    "vitest": "5.0.5"
  }
}
